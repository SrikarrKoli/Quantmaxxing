# Worker origin in production (leave empty locally: Vite proxies /api and /ws).
VITE_API_ORIGIN=
# Firebase web config (public values from Firebase console > Project settings > Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=quantmaxxing.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=quantmaxxing
VITE_FIREBASE_APP_ID=
# Set to http://127.0.0.1:9099 to use the Firebase Auth emulator locally.
VITE_AUTH_EMULATOR=
