{
  "name": "quantmaxxing",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time competitive mental math: same questions, fixed clock, most correct answers wins.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/shared", "packages/server", "packages/web"],
  "scripts": {
